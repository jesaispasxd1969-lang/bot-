RR_CHANNEL_NAME=├🏆・rr-check

# Fréquence de vérification des parties, en secondes (180 = 3 min)
RR_POLL_INTERVAL=180
RR_DEFAULT_REGION=eu
RR_DEFAULT_PLATFORM=pc
RR_PAGE_SIZE=10

# Heure du récap journalier automatique (0-23, heure de Paris)
RR_DAILY_RECAP_HOUR=23
RR_TIMEZONE=Europe/Paris

# Attribution auto du rôle de rang après chaque partie (1 = actif, 0 = désactivé)
RR_AUTO_SYNC_ROLES=1

